# Copy to .env.n8n (git-ignored). Generate secrets with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Must match the Convex env vars of the same purpose.
LENDLOOP_N8N_WEBHOOK_SECRET=
LENDLOOP_CONVEX_HTTP_SECRET=
# Convex HTTP actions base URL, e.g. https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=
