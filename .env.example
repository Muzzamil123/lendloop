# Next.js app (.env.local). `npx convex dev` writes the two CONVEX lines itself.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment env (set with `npx convex env set NAME value`, not in a file):
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxxx.clerk.accounts.dev
# ADMIN_EMAILS              comma-separated emails that get the admin role
# N8N_WEBHOOK_URL           n8n request-notification webhook URL
# N8N_WEBHOOK_SECRET        HMAC secret, Convex -> n8n
# CONVEX_HTTP_SECRET        HMAC secret, n8n -> Convex
